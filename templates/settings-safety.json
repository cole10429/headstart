{
  "cleanupPeriodDays": 3650,
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.token)",
      "Read(**/*.secrets)",
      "Read(**/*credentials*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout .)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git checkout .)",
      "PowerShell(git checkout -- .)",
      "PowerShell(git restore .)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm --recursive*)",
      "Bash(rm * -r*)",
      "Bash(rm * -R*)",
      "Bash(rm * --recursive*)",
      "Bash(rd /s*)",
      "Bash(* rd /s*)",
      "Bash(rmdir /s*)",
      "Bash(* rmdir /s*)",
      "Bash(del /s*)",
      "Bash(* del /s*)",
      "Bash(*Remove-Item*-Recurse*)",
      "Bash(*Remove-Item* -r *)",
      "Bash(git push:*)",
      "Bash(* git push*)",
      "Bash(gh pr merge:*)",
      "Bash(vercel deploy*)",
      "Bash(vercel --prod*)",
      "Bash(netlify deploy*)",
      "Bash(*supabase db push*)",
      "Bash(*supabase functions deploy*)",
      "Bash(npm publish*)",
      "PowerShell(Remove-Item*-Recurse*)",
      "PowerShell(Remove-Item* -r *)",
      "PowerShell(Remove-Item* -r)",
      "PowerShell(*rd /s*)",
      "PowerShell(*rmdir /s*)",
      "PowerShell(*del /s*)",
      "PowerShell(git push*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(vercel deploy*)",
      "PowerShell(vercel --prod*)",
      "PowerShell(netlify deploy*)",
      "PowerShell(*supabase db push*)",
      "PowerShell(*supabase functions deploy*)",
      "PowerShell(npm publish*)"
    ]
  }
}
